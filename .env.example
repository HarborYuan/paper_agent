# Database Configuration
# Use SQLite for local MVP
DATABASE_URL="sqlite:///data/paper_agent.db"

# LLM Provider — OpenRouter (default). Any OpenAI-compatible endpoint also works.
# Required for Scoring and Summarization
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Legacy fallback (used only if OPENROUTER_API_KEY is empty):
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Default models (OpenRouter ids). Every key in this file can also be edited from the Settings page,
# which writes the new value back here and applies it without a restart.
LLM_MODEL_STAGE1="openai/gpt-4o-mini"          # stage 1: cheap screening on title+abstract (all papers)
LLM_MODEL_STAGE2="anthropic/claude-sonnet-5"    # stage 2: careful review w/ intro text (papers >= STAGE2_THRESHOLD)
LLM_MODEL_SUMMARY="openai/gpt-4o-mini"         # full-text summarization (papers >= SCORE_THRESHOLD)
STAGE2_THRESHOLD=60
SCORE_THRESHOLD=85
STAGE2_TEXT_CHAR_LIMIT=8000

# Notification Configuration (Optional - Lark / 飞书 Webhook)
LARK_WEBHOOK_URL=""

ARXIV_CATEGORIES=["cs.CV","cs.CL","cs.AI"]

# Summary language: EN / CN
SUMMARY_LANGUAGE="EN"

# User Profile
USER_PROFILE="I am interested in Computer Vision and Multi-modal Learning. Keywords: Video Understanding, VLM, Segmentation, Reasoning, 3D. Avoid: Network Security, Pure Math, Remote Sensing, HCI."

# Auto Update Configuration
ENABLE_AUTO_UPDATE=true
AUTO_UPDATE_TIME="04:00" # UTC
