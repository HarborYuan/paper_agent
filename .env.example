# Database Configuration
# Use SQLite for local MVP
DATABASE_URL="sqlite:///data/paper_agent.db"

# Claude API (required): screen -> review -> deep read + translation, and the trend reports.
# Every key in this file can also be edited from the Settings page, which writes the new value back
# here and applies it without a restart.
ANTHROPIC_API_KEY=""
LLM_MODEL_STAGE1="claude-haiku-5-5"     # ① screen: title + abstract of every new paper -> relevance tier
LLM_MODEL_STAGE2="claude-sonnet-5-5"    # ② review: abstract + first part -> verdict, affiliations, project matches
LLM_MODEL_SUMMARY="claude-sonnet-5-5"   # ③ deep read: whole paper -> final verdict, TL;DR, notes, claim flags
LLM_MODEL_TRANSLATE="claude-haiku-5-5"  # full Chinese translation for the reading page
LLM_MODEL_REPORT="claude-sonnet-5-5"    # daily / weekly / monthly trend reports
SCREEN_MIN_RELEVANCE=4                  # screen tier needed for review
STAGE2_TEXT_CHAR_LIMIT=20000            # excerpt shown to the reviewer
DEEP_READ_MAX_PER_RUN=12
LLM_USE_BATCH=true                      # nightly stages via the Message Batches API (50% off, slower)
CLAUDE_MONTHLY_BUDGET=80                # USD per billing cycle; stages are trimmed / skipped beyond it
CLAUDE_BUDGET_RESET_DAY=1
PROJECT_SIM_THRESHOLD=0.74              # embedding recall for projects (voyage-4 cosine)

# Embeddings (semantic search / related papers / project recall) — OpenRouter
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
EMBEDDING_MODEL="voyageai/voyage-4"
EMBEDDING_DIM=512              # 0 = native; Matryoshka models accept 256/512/1024

# Reports: trend summaries over the selected papers, pushed right after the daily digest
REPORT_DAILY_ENABLED=true      # after each run: the papers pushed in that run
REPORT_WEEKLY_ENABLED=true     # on REPORT_WEEKLY_DAY: the previous 7 days
REPORT_MONTHLY_ENABLED=true    # on the 1st: the previous calendar month
REPORT_WEEKLY_DAY=0            # 0 = Monday ... 6 = Sunday (UTC)

# Hot papers (Hugging Face Daily Papers): own digest section, relevant or not
HOT_ENABLED=true
HOT_MIN_UPVOTES=50
HOT_MIN_STARS=500
HOT_MAX_PER_RUN=5
HOT_WEB_SEARCH=false

# Reading-page links in Lark messages
# PUBLIC_BASE_URL="http://nas:8000"

# Notification Configuration (Optional - Lark / 飞书 Webhook)
LARK_WEBHOOK_URL=""

ARXIV_CATEGORIES=["cs.CV","cs.CL","cs.AI"]

# Summary language: EN / CN
SUMMARY_LANGUAGE="EN"

# User Profile
USER_PROFILE="I am interested in Computer Vision and Multi-modal Learning. Keywords: Video Understanding, VLM, Segmentation, Reasoning, 3D. Avoid: Network Security, Pure Math, Remote Sensing, HCI."

# Auto Update Configuration
ENABLE_AUTO_UPDATE=true
AUTO_UPDATE_TIME="04:00" # UTC
